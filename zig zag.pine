//@version = 6
indicator("j 7" , "zz" , true, max_lines_count = 500)

dmn = 5
var lst_pvt = ""

var float pst_top_prc = na , var int pst_top_bar = na
var float lst_top_prc = na , var int lst_top_bar = na

var float pst_bot_prc = na , var int pst_bot_bar = na
var float lst_bot_prc = na , var int lst_bot_bar = na

top = ta.pivothigh(dmn , dmn)
bot = ta.pivotlow (dmn , dmn)


var line inc = na , var line dec = na ,



if lst_pvt == "top" or lst_pvt == "bot-top"
    if low <= lst_bot_prc
        if high >= lst_top_prc
            if (high-open) < (open-low)
                lst_top_prc := high , lst_top_bar := bar_index
                inc.set_x2(lst_top_bar) , inc.set_y2(lst_top_prc)                
                lst_pvt := "bot"
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low   , lst_bot_bar := bar_index
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
            else
                lst_pvt := "bot-top"
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low   , lst_bot_bar := bar_index
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
                pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
                lst_top_prc := high   , lst_top_bar := bar_index
                inc := line.new(lst_bot_bar , lst_bot_prc , lst_top_bar , lst_top_prc , color = color.blue)
        else
            lst_pvt := "bot"
            pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
            lst_bot_prc := low   , lst_bot_bar := bar_index
            dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
    else if high >= lst_top_prc      
        if bool(bot)
            // label.new(bar_index+dmn,high , lst_pvt)
            if bar_index >= (lst_top_bar+dmn+1)
                lst_pvt := "bot"
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low [dmn]   , lst_bot_bar := bar_index[dmn]
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
            else
                lst_top_prc := high , lst_top_bar := bar_index
                inc.set_x2(lst_top_bar) , inc.set_y2(lst_top_prc)
        else
            lst_top_prc := high , lst_top_bar := bar_index
            inc.set_x2(lst_top_bar) , inc.set_y2(lst_top_prc)
    else
        if (bool(bot) and bool(top))
            if (open[dmn]-low[dmn]) > (high[dmn]-open[dmn])
                // lst_top_prc := high[dmn] , lst_top_bar := bar_index[dmn]
                lst_pvt := "bot"
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low [dmn]   , lst_bot_bar := bar_index[dmn]
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
            else
                lst_pvt := "bot-top"
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low [dmn]   , lst_bot_bar := bar_index[dmn]
                pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
                lst_top_prc := high[dmn]   , lst_top_bar := bar_index[dmn]
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
                inc := line.new(lst_bot_bar , lst_bot_prc , lst_top_bar , lst_top_prc , color = color.blue)
        else if bool(bot)
            if bar_index >= (lst_top_bar+dmn+1)
                lst_pvt := "bot"
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low [dmn]   , lst_bot_bar := bar_index[dmn]
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)



else if lst_pvt == "bot" or lst_pvt == "top-bot"
    if high >= lst_top_prc
        if low <= lst_bot_prc
            if (open-low) < (high-open)
                lst_bot_prc := low , lst_bot_bar := bar_index
                dec.set_x2(lst_bot_bar) , dec.set_y2(lst_bot_prc)                
                lst_pvt := "top"
                pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
                lst_top_prc := high  , lst_top_bar := bar_index
