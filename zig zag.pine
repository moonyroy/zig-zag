            dec.set_x2(lst_bot_bar) , dec.set_y2(lst_bot_prc)
    else
        if (bool(top) and bool(bot))
            if (open[dmn]-low[dmn]) < (high[dmn]-open[dmn])
                // lst_bot_prc := low [dmn] , lst_bot_bar := bar_index[dmn]
                lst_pvt := "top"
                pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
                lst_top_prc := high[dmn]   , lst_top_bar := bar_index[dmn]
                inc := line.new(lst_bot_bar , lst_bot_prc , lst_top_bar , lst_top_prc , color = color.blue)
            else
                lst_pvt := "top-bot"
                pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
                lst_top_prc := high[dmn]   , lst_top_bar := bar_index[dmn]
                pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
                lst_bot_prc := low [dmn]   , lst_bot_bar := bar_index[dmn]
                inc := line.new(lst_bot_bar , lst_bot_prc , lst_top_bar , lst_top_prc , color = color.blue)
                dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
        else if bool(top)
            if bar_index >= (lst_bot_bar+dmn+1)
                lst_pvt := "top"
                pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
                lst_top_prc := high[dmn]   , lst_top_bar := bar_index[dmn]
                inc := line.new(lst_bot_bar , lst_bot_prc , lst_top_bar , lst_top_prc , color = color.blue)


else if lst_pvt == ""
    if (bool(top) and bool(bot))
        if (open[dmn]-low[dmn]) < (high[dmn]-open[dmn])
            lst_pvt := "bot-top"
            pst_bot_prc := lst_bot_prc , pst_bot_bar := lst_bot_bar
            lst_bot_prc := low [dmn]   , lst_bot_bar := bar_index[dmn]
            pst_top_prc := lst_top_prc , pst_top_bar := lst_top_bar
            lst_top_prc := high[dmn]   , lst_top_bar := bar_index[dmn]
            dec := line.new(lst_top_bar , lst_top_prc , lst_bot_bar , lst_bot_prc , color = color.orange)
            inc := line.new(lst_bot_bar , lst_bot_prc , lst_top_bar , lst_top_prc , color = color.blue)
        else
            lst_pvt := "top-bot"
